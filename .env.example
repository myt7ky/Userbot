# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# api_id / api_hash с https://my.telegram.org (нужны для проверки юзов через аккаунт)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Telegram ID тех, кому можно пользоваться ботом (через запятую). Узнать свой ID: @userinfobot
ADMIN_IDS=111111111
# Пауза между проверками в секундах (меньше 2 — быстро словите FloodWait)
CHECK_DELAY=3
# Имя файла сессии Telethon
SESSION_NAME=checker
