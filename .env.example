# ===== Обязательное =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# api_id / api_hash с https://my.telegram.org — проверка юзов идёт через ваш аккаунт
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=111111111

# ===== Монетизация =====
# Бесплатных поисков новому пользователю
FREE_SEARCHES=1
# Сколько свободных юзов выдаёт один поиск
RESULTS_PER_SEARCH=5
# Пакеты: поисков:звёзд через запятую
PACKS=1:10,5:40,15:100
# Бесплатных ручных проверок юзов в сутки на пользователя
FREE_CHECKS_PER_DAY=10
# Контакт для /paysupport (например @your_support)
SUPPORT=

# ===== Тонкая настройка =====
# Пауза между проверками в секундах (меньше 2 — быстро словите FloodWait)
CHECK_DELAY=3
# Сколько поисков идёт одновременно, остальные ждут в очереди
MAX_PARALLEL_HUNTS=2
# После скольких проверок поиск сдаётся (и возвращает попытку, если ничего не нашёл)
MAX_CHECKS_PER_SEARCH=200
# Аккаунты-проверяльщики. Несколько через запятую = проверка в несколько раз быстрее:
# SESSION_NAME=checker,checker2,checker3  → потом python -m userhunter.login (спросит номера новых)
SESSION_NAME=checker
# Быстрый отсев явно занятых юзов через сайт t.me (1 — вкл, 0 — выкл)
WEB_PREFILTER=1
DB_PATH=usernames.db
# Автозахват юзов на каналы в поисках админа (переключается в 🛠 Админке)
AUTO_GRAB=0
GRAB_ABOUT=
